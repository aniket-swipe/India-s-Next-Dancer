# Copy to backend/.env and fill in. Never commit the real .env.
PORT=4000
# Public site origin, used in emails and payment links
SITE_URL=https://indiasnextdancer.com

# Rupees, inclusive of GST
REGISTRATION_FEE=590
# ISO date-time with timezone. Registrations are refused after this moment.
REGISTRATION_DEADLINE=2027-03-31T23:59:59+05:30

# Razorpay — leave empty to run in MOCK payment mode (development only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP — leave SMTP_HOST empty to only log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="India's Next Dancer <support@kgilproduction.com>"

# Required to open the admin list at /register/?admin
ADMIN_TOKEN=
